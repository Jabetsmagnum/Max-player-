<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/widget_art_frame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_art_placeholder">

        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/now_playing"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_art_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="♪"
            android:textColor="#16130A"
            android:textSize="26sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="#F5F6F8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_description"
            android:textColor="#A7ACB8"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⏮"
        android:textColor="#F5F6F8"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_button_bg"
        android:gravity="center"
        android:text="▶"
        android:textColor="#16130A"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="⏭"
        android:textColor="#F5F6F8"
        android:textSize="20sp" />
</LinearLayout>
